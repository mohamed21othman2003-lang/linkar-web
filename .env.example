# انسخ الملف ده لـ .env جنب docker-compose.yml وعدّل القيم

# الدومين النهائي للموقع (بيظهر في sitemap.xml و robots.txt) — بيتدمج وقت البناء، فبعد تغييره اعمل --build
NEXT_PUBLIC_SITE_URL=https://linkar-web.vercel.app

# البورت على السيرفر، والعنوان اللي بيسمع عليه
# 127.0.0.1 = من خلال nginx بس (الأفضل) — 0.0.0.0 = مفتوح مباشرة
WEB_PORT=3000
BIND_ADDR=127.0.0.1

# لوحة التحكم (خدمة admin) — البورت على السيرفر، ورابط الـAPI لما الخادم يجهز
ADMIN_PORT=3001
ADMIN_API_URL=
