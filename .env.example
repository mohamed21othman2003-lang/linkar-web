# Copy this file to .env next to docker-compose.yml and edit the values

# Final public URL of the website (used in sitemap.xml and robots.txt) — baked in at build time,
# so run "docker compose up -d --build" after changing it
NEXT_PUBLIC_SITE_URL=https://linkar-web.vercel.app

# Host ports and the address they listen on
# 127.0.0.1 = reachable only through nginx / a reverse proxy (recommended) — 0.0.0.0 = exposed directly
WEB_PORT=3000
BIND_ADDR=127.0.0.1

# Control panel (admin service) — host port, and the backend API URL once it exists (empty = demo data)
ADMIN_PORT=3001
ADMIN_API_URL=
# Serve the panel under a path of the website's domain (e.g. /admin -> https://linkar.ido.sa/admin).
# Empty = the panel has its own (sub)domain. Baked in at build time.
ADMIN_BASE_PATH=
